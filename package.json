{
  "name": "hikmahone-leadops",
  "version": "0.0.1",
  "private": true,
  "description": "HikmahOne LeadOps – production-grade CRM monorepo",
  "scripts": {
    "dev": "pnpm --filter @leadops/shared build && turbo run dev --parallel --filter=@leadops/api --filter=@leadops/worker --filter=@leadops/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @leadops/api prisma:generate",
    "db:migrate": "pnpm --filter @leadops/api prisma:migrate",
    "db:seed": "pnpm --filter @leadops/api prisma:seed",
    "db:studio": "pnpm --filter @leadops/api prisma:studio"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.3",
    "turbo": "^2.5.6",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "@scarf/scarf",
      "esbuild",
      "msgpackr-extract",
      "prisma"
    ]
  }
}
