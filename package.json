{
  "name": "hikmahone-leadops",
  "version": "0.0.1",
  "private": true,
  "description": "HikmahOne LeadOps – production-grade CRM monorepo",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @leadops/api dev\" \"pnpm --filter @leadops/web dev\"",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @leadops/api prisma:generate",
    "db:migrate": "pnpm --filter @leadops/api prisma:migrate",
    "db:seed": "pnpm --filter @leadops/api prisma:seed",
    "db:studio": "pnpm --filter @leadops/api prisma:studio"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "@scarf/scarf",
      "esbuild",
      "msgpackr-extract",
      "prisma"
    ]
  }
}
