# Application
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://leadops:leadops_secret@localhost:5432/leadops_dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT — change this in production! Must be at least 32 characters.
JWT_SECRET=dev-super-secret-change-in-production-min-32
JWT_EXPIRES_IN=7d

# Multi-tenancy
# Set to "single" to skip tenant header resolution (single-tenant mode)
# Set to "multi" for SaaS mode (tenant from subdomain or x-tenant-id header)
DEPLOYMENT_MODE=single

# Used only when DEPLOYMENT_MODE=single
# After seeding, fill this with the UUID of the 'local' tenant:
#   SELECT id FROM tenants WHERE slug = 'local';
SINGLE_TENANT_ID=
