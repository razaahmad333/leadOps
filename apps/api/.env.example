NODE_ENV=development
PORT=3000

# Local dev CORS only; production should terminate CORS upstream.
CORS_ORIGIN=http://localhost:5173

# Postgres
DATABASE_URL=postgresql://leadops:leadops_secret@localhost:5432/leadops_dev

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (change in production)
JWT_SECRET=dev-super-secret-change-in-production-min-32
JWT_EXPIRES_IN=7d

# MessageBird OTP (optional in local development; without this the API falls back to a dev OTP)
MESSAGEBIRD_ACCESS_KEY=
MESSAGEBIRD_VERIFY_ORIGINATOR=HikmahOne
MESSAGEBIRD_VERIFY_TEMPLATE=Your HikmahOne verification code is %token.
MESSAGEBIRD_VERIFY_TIMEOUT_SECONDS=300

# Multi-tenancy mode: single | multi
DEPLOYMENT_MODE=multi

# Used in single-tenant mode
SINGLE_TENANT_ID=
