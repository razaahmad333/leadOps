generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PENDING
  WON
  LOST
}

model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  config         TenantConfig?
  users          User[]
  leads          Lead[]
  followUps      FollowUp[]
  leadActivities LeadActivity[]
  webhookEvents  WebhookMessage[]
  roles          PermissionRole[]
  branches       Branch[]

  @@map("tenants")
}

model TenantConfig {
  id            String   @id @default(uuid())
  tenantId      String   @unique @map("tenant_id")
  industryPreset String  @default("GENERIC") @map("industry_preset")
  configVersion Int      @default(1) @map("config_version")
  displayConfig Json?    @map("display_config")
  timezone      String   @default("UTC")
  businessStart String   @default("09:00") @map("business_start")
  businessEnd   String   @default("18:00") @map("business_end")
  stages        Json
  reminderRules Json     @map("reminder_rules")
  templates     Json
  featureFlags  Json     @map("feature_flags")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_configs")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  email        String
  name         String
  phone        String?
  passwordHash String   @map("password_hash")
  role         Role     @default(STAFF)
  isSuperAdmin Boolean  @default(false) @map("is_super_admin")
  isTenantAdmin Boolean @default(false) @map("is_tenant_admin")
  status       UserStatus @default(ACTIVE)
  defaultBranchId String? @map("default_branch_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultBranch  Branch?            @relation("UserDefaultBranch", fields: [defaultBranchId], references: [id], onDelete: SetNull)
  followUps      FollowUp[]
  activities     LeadActivity[]
  ownedLeads     Lead[]             @relation("LeadOwner")
  userRoles      UserRole[]
  branchScopes   UserBranchScope[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@map("users")
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String
  group       String
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model PermissionRole {
  id          String   @id @default(uuid())
  tenantId     String?  @map("tenant_id")
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       PermissionRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role PermissionRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Branch {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usersDefault  User[]             @relation("UserDefaultBranch")
  usersScopes   UserBranchScope[]
  leads         Lead[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("branches")
}

model UserBranchScope {
  userId    String   @map("user_id")
  branchId  String   @map("branch_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branch_scopes")
}

model Lead {
  id             String     @id @default(uuid())
  tenantId       String     @map("tenant_id")
  ownerId        String?    @map("owner_id")
  branchId       String?    @map("branch_id")
  stageKey       String?    @map("stage_key")
  name           String
  phone          String?
  email          String?
  source         String?
  intakeData     Json?      @map("intake_data")
  status         LeadStatus @default(NEW)
  nextFollowUpAt DateTime?  @map("next_follow_up_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner      User?          @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  branch     Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  followUps  FollowUp[]
  activities LeadActivity[]

  @@index([tenantId, status])
  @@index([tenantId, stageKey])
  @@index([tenantId, nextFollowUpAt])
  @@index([tenantId, branchId])
  @@map("leads")
}

model FollowUp {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  leadId      String    @map("lead_id")
  assignedTo  String?   @map("assigned_to")
  kind        String    @default("GENERAL")
  scheduledAt DateTime  @map("scheduled_at")
  note        String?
  done        Boolean   @default(false)
  doneAt      DateTime? @map("done_at")
  escalatedAt DateTime? @map("escalated_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([tenantId, done, scheduledAt])
  @@map("follow_ups")
}

model LeadActivity {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  leadId    String   @map("lead_id")
  actorId   String?  @map("actor_id")
  type      String
  message   String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, leadId, createdAt])
  @@map("lead_activities")
}

model WebhookMessage {
  id          String    @id @default(uuid())
  tenantId    String?   @map("tenant_id")
  provider    String
  messageId   String    @map("message_id")
  payloadHash String?   @map("payload_hash")
  status      String    @default("RECEIVED")
  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([provider, messageId])
  @@index([tenantId, provider])
  @@map("webhook_messages")
}
